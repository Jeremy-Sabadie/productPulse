{
  "/api/**": {
    "target": "http://localhost:8080",
    "secure": false,
    "changeOrigin": true
  },
  "/mypopote-api/**": {
    "target": "https://my-popote.duckdns.org",
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": {
      "^/mypopote-api": "/api"
    },
    "headers": {
      "Origin": "https://my-popote.duckdns.org"
    }
  }
}